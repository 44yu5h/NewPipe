<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.navigation.NavigationView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="?android:attr/windowBackground"
    android:orientation="vertical"
    android:elevation="8dp"
    android:fitsSystemWindows="true"
    app:itemIconTint="?attr/colorAccent"
    app:itemTextColor="?android:textColorPrimary"
    app:itemShapeFillColor="@android:color/transparent"
    app:itemShapeInsetStart="12dp"
    app:itemShapeInsetEnd="12dp"
    app:itemShapeInsetTop="4dp"
    app:itemShapeInsetBottom="4dp"
    app:itemShapeAppearance="@style/ShapeAppearance.NewPipe.SmallComponent"
    app:headerLayout="@layout/drawer_header" />
