<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Modern typography styles based on Material 3 -->
    
    <!-- Display styles - for large, high-emphasis text -->
    <style name="TextAppearance.NewPipe.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">57sp</item>
        <item name="lineHeight">64sp</item>
    </style>
    
    <style name="TextAppearance.NewPipe.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">45sp</item>
        <item name="lineHeight">52sp</item>
    </style>
    
    <!-- Headline styles - for medium-emphasis text -->
    <style name="TextAppearance.NewPipe.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="lineHeight">40sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextAppearance.NewPipe.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="lineHeight">36sp</item>
    </style>
    
    <style name="TextAppearance.NewPipe.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="lineHeight">32sp</item>
    </style>
    
    <!-- Title styles - for smaller, medium-emphasis text -->
    <style name="TextAppearance.NewPipe.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="lineHeight">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextAppearance.NewPipe.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextAppearance.NewPipe.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <!-- Body styles - for body text -->
    <style name="TextAppearance.NewPipe.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
    </style>
    
    <style name="TextAppearance.NewPipe.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
    </style>
    
    <style name="TextAppearance.NewPipe.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
    </style>
    
    <!-- Label styles - for labels and captions -->
    <style name="TextAppearance.NewPipe.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextAppearance.NewPipe.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextAppearance.NewPipe.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
