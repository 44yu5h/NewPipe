<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shape for images with rounded top corners -->
    <style name="ShapeAppearance.NewPipe.Image.Top" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Shape for fully rounded images -->
    <style name="ShapeAppearance.NewPipe.Image.Rounded" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Shape for circular images -->
    <style name="ShapeAppearance.NewPipe.Image.Circle" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
