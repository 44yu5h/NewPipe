<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Modern button styles -->
    
    <!-- Filled button - primary action -->
    <style name="Widget.NewPipe.Button.Filled" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.NewPipe.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">2dp</item>
    </style>
    
    <!-- Outlined button - secondary action -->
    <style name="Widget.NewPipe.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.NewPipe.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeWidth">1dp</item>
    </style>
    
    <!-- Text button - tertiary action -->
    <style name="Widget.NewPipe.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.NewPipe.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <!-- Icon button - for toolbar actions -->
    <style name="Widget.NewPipe.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">0dp</item>
    </style>
    
    <!-- Floating action button -->
    <style name="Widget.NewPipe.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.NewPipe.FloatingActionButton</item>
        <item name="elevation">6dp</item>
        <item name="hoveredFocusedTranslationZ">8dp</item>
    </style>
    
    <style name="ShapeAppearance.NewPipe.FloatingActionButton" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">16dp</item>
    </style>
    
    <!-- Extended FAB -->
    <style name="Widget.NewPipe.ExtendedFloatingActionButton" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.NewPipe.ExtendedFAB</item>
        <item name="elevation">6dp</item>
    </style>
    
    <style name="ShapeAppearance.NewPipe.ExtendedFAB" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">16dp</item>
    </style>
    
    <!-- Chip styles -->
    <style name="Widget.NewPipe.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">12dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:textAppearance">@style/TextAppearance.NewPipe.LabelMedium</item>
    </style>
    
    <style name="Widget.NewPipe.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">12dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:textAppearance">@style/TextAppearance.NewPipe.LabelMedium</item>
    </style>
</resources>
